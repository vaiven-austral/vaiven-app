    {
      "parameters": {
        "jsCode": "const origen = $('Original Post').first().json.body[0];\nconst candidatos = $input.all().map(item => item.json);\n\nif (candidatos.length === 0) return [];\n\nconst FACTOR_RESOLUCION_STUB = 40.0;\nconst FACTOR_URGENCIA = calcularFactorUrgencia(\n    origen.urgencia || 'sin_apuro');\n\nfunction calcularFactorProximidad(zonaOrigen, zonaCandidato) {\n  if (!zonaOrigen || !zonaCandidato) return 0.0;\n  \n  // Misma localidad (Mismo ID exacto) -> 20 pts\n  if (zonaOrigen.id === zonaCandidato.id) return 20 * 1; \n  \n  // Mismo partido (y region) -> 13.33 pts\n  if (zonaOrigen.partido === zonaCandidato.partido && zonaOrigen.region === zonaCandidato.region) {\n      return 20 * (2/3); \n  }\n  \n  // Solo misma region -> 6.67 pts\n  if (zonaOrigen.region === zonaCandidato.region) {\n      return 20 * (1/3);\n  }\n  \n  // Sin concidencias\n  return 0.0; \n}\n\nfunction calcularFactorUrgencia(urgencia) {\n  if (urgencia === 'alta') return 25.0;\n  if (urgencia === 'media') return 16.25;\n  return 8.75; // sin_apuro o default\n}\n\nconst resultados = candidatos.map(candidato => {\n  const f1_resolucion = FACTOR_RESOLUCION_STUB;\n\n  const f2_urgencia = FACTOR_URGENCIA;\n\n  const f3_proximidad = calcularFactorProximidad(origen.zona_id, candidato.zona_id);\n\n  let f4_confianza = 0.0;\n  if (candidato.perfiles) {\n    let campos = 0;\n    if (candidato.perfiles.avatar_ruta) campos++;\n    if (candidato.perfiles.zona_id) campos++;\n    f4_confianza = 10 * (campos / 2);\n  }\n\n  const largo = Math.min(\n    (candidato.descripcion || '').length / 100, 1);\n  let f5_calidad = 0.0;\n  if (candidato.tipo === 'donacion') {\n    f5_calidad = 5 * (0.50 * 0 + 0.30 * largo + 0.20 * 0);\n  } else {\n    f5_calidad = 5 * (0.60 * largo + 0.40 * 0);\n  }\n\n  const score_total = f1_resolucion + f2_urgencia \n    + f3_proximidad + f4_confianza + f5_calidad;\n\n  return {\n    ...candidato,\n    score_total: Number(score_total.toFixed(4)),\n    factores: {\n      f1_resolucion,\n      f2_urgencia,\n      f3_proximidad: Number(f3_proximidad.toFixed(4)),\n      f4_confianza,\n      f5_calidad: Number(f5_calidad.toFixed(4))\n    }\n  };\n});\n\n// Ordenamiento Descendente (de mayor a menor score)\nresultados.sort((a, b) => b.score_total - a.score_total);\n\n// Transformamos de vuelta al formato que entiende n8n\nreturn resultados.map(item => ({ json: item }));"
      },
