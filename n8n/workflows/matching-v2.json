    {
      "parameters": {
        "jsCode": "const origen = $('Origen').first().json.body[0];\nconst candidatos = $('Candidatas Motor').first().json.body;\nconst juicios = $('Juicios Existentes').first().json.body;\n\nconst esOrigenDonacion = origen.tipo === 'donacion';\n\n// Un par ya juzgado se identifica por el id del candidato, del lado\n// contrario al de origen: si el origen es donación, el candidato es\n// necesidad y su id vive en necesidad_id (y viceversa).\nconst yaJuzgados = new Set(\n  juicios.map((j) => (esOrigenDonacion ? j.necesidad_id : j.donacion_id))\n);\n\nconst pendientes = candidatos\n  .filter((candidato) => !yaJuzgados.has(candidato.id))\n  .map((candidato) => {\n    const donacion = esOrigenDonacion ? origen : candidato;\n    const necesidad = esOrigenDonacion ? candidato : origen;\n\n    return {\n      donacion_id: donacion.id,\n      necesidad_id: necesidad.id,\n      donacion: {\n        titulo: donacion.titulo,\n        descripcion: donacion.descripcion,\n        categoria: donacion.categorias ? donacion.categorias.nombre : null,\n        cantidad: donacion.cantidad,\n        estado_objeto: donacion.estado_objeto,\n      },\n      necesidad: {\n        titulo: necesidad.titulo,\n        descripcion: necesidad.descripcion,\n        categoria: necesidad.categorias ? necesidad.categorias.nombre : null,\n        cantidad: necesidad.cantidad,\n      },\n    };\n  });\n\nreturn [{ json: { pares: pendientes } }];"
      },
      "type": "n8n-nodes-base.code",
