    {
      "parameters": {
        "jsCode": "const origen = $('Original Post').first().json.body[0];\nconst candidatos = $input.first().json.body;\n\nif (candidatos.length === 0) return [];\n\n// ============================================\n// CONFIGURACIÓN CENTRALIZADA DE PESOS\n// ============================================\nconst PESOS = {\n  RESOLUCION: 40.0, // Stub Capa 1 (Hito 3) - Capa 2 con IA lo reemplaza en Hito 4\n  FACTOR_2: {\n    max: 10.0,\n    \n    URGENCIA: { // Si el post original es una donacion se usa este\n      sin_apuro: 1 / 3,\n      media: 2 / 3,\n      alta: 3 / 3\n        },\n    ESTADO: { // Si el post original es una necesidad se usa este\n      requiere_reparacion: 1 / 5,\n      usado: 2 / 5,\n      bueno: 3 / 5,\n      como_nuevo: 4 / 5,\n      nuevo: 5 / 5\n      }\n  },\n  PROXIMIDAD: {\n    max: 20,\n    localidad: 1,\n    partido: 2 / 3,\n    region: 1 / 3,\n    ninguna: 0,\n  },\n  CONFIANZA: {\n    max: 10,\n    campos_totales: 2, // perfiles.avatar_ruta + perfiles.zona_id\n  },\n  CALIDAD: {\n    max: 5,\n    largo: 0.60,\n    imagen: 0.40,\n  },\n  CATEGORIA: {\n    max: 15\n  }\n};\n\nfunction calcularFactorProximidad(zonaOrigen, zonaCandidato) {\n  if (!zonaOrigen || !zonaCandidato) return PESOS.PROXIMIDAD.max * PESOS.PROXIMIDAD.ninguna;\n\n  // Misma localidad (Mismo ID exacto)\n  if (zonaOrigen.id === zonaCandidato.id) {\n    return PESOS.PROXIMIDAD.max * PESOS.PROXIMIDAD.localidad;\n  }\n\n  // Mismo partido (y region)\n  if (zonaOrigen.partido === zonaCandidato.partido && zonaOrigen.region === zonaCandidato.region) {\n    return PESOS.PROXIMIDAD.max * PESOS.PROXIMIDAD.partido;\n  }\n\n  // Solo misma region\n  if (zonaOrigen.region === zonaCandidato.region) {\n    return PESOS.PROXIMIDAD.max * PESOS.PROXIMIDAD.region;\n  }\n\n  // Sin coincidencias\n  return PESOS.PROXIMIDAD.max * PESOS.PROXIMIDAD.ninguna;\n}\n\nfunction calcularFactorUrgencia(urgencia) {\n  return PESOS.FACTOR_2.URGENCIA[urgencia] ?? 0;\n}\n\nfunction calcularFactorEstadoObjeto(estadoObjeto) {\n  return PESOS.FACTOR_2.ESTADO[estadoObjeto] ?? 0;\n}\n  \nfunction calcularFactorPrioridad(candidato) {\n  return candidato.tipo === 'necesidad'\n    ? calcularFactorUrgencia(candidato.urgencia)\n    : calcularFactorEstadoObjeto(candidato.estado_objeto);\n}\n\n\nconst resultados = candidatos.map(candidato => {\n  \n  const f1_resolucion = PESOS.RESOLUCION;\n  \n  const f2_urgencia = calcularFactorPrioridad(candidato) * PESOS.FACTOR_2.max;\n\n  const f3_proximidad = calcularFactorProximidad(origen.zonas, candidato.zonas);\n\n  let f4_confianza = 0.0;\n  if (candidato.perfiles) {\n    let campos = 0;\n    if (candidato.perfiles.avatar_ruta) campos++;\n    if (candidato.perfiles.zona_id) campos++;\n    f4_confianza = PESOS.CONFIANZA.max * (campos / PESOS.CONFIANZA.campos_totales);\n  }\n\n  const largo = Math.min((candidato.descripcion || '').length / 100, 1);\n  const tiene_imagen = Array.isArray(candidato.imagenes_publicacion) && candidato.imagenes_publicacion.length > 0 ? 1 : 0;\n\n  const f5_calidad = PESOS.CALIDAD.max * (PESOS.CALIDAD.largo * largo + PESOS.CALIDAD.imagen * tiene_imagen); \n  \n  const f6_categoria = candidato.categoria_id === origen.categoria_id ? PESOS.CATEGORIA.max : 0;\n\n  const score_total = f1_resolucion + f2_urgencia\n    + f3_proximidad + f4_confianza + f5_calidad + f6_categoria;\n\n  return {\n    ...candidato,\n    score_total: score_total,\n    factores: {\n      f1_resolucion,\n      f2_urgencia,\n      f3_proximidad,\n      f4_confianza,\n      f5_calidad, \n      f6_categoria\n    }\n  };\n}); \n\n// Ordenamiento Descendente (de mayor a menor score)\nresultados.sort((a, b) => b.score_total - a.score_total);\n\n// Transformamos de vuelta al formato que entiende n8n\nreturn resultados.map(item => ({ json: item }));"
      },
