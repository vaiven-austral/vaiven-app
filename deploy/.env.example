# Copiar a .env en la VM (chmod 600). Nunca al repo.
N8N_HOST=<ip-con-guiones>.sslip.io
# openssl rand -hex 32 — guardarla también en el canal privado: sin ella, las credenciales de n8n no se pueden leer
N8N_ENCRYPTION_KEY=<clave-de-cifrado>
# Usuario y contraseña delante del editor. El hash sale de:
#   sudo docker run --rm caddy:2.10 caddy hash-password --plaintext '<contraseña>'
# Va entre comillas simples: el hash tiene signos $ y compose los interpretaría.
CADDY_USER=vaiven
CADDY_HASH='<hash-bcrypt>'
